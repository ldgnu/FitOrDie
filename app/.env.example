# FitOrDie (Go + SQLite) — copiar a .env. El .env real NUNCA se commitea.
# Puerto y bind: 3007 en todas las interfaces (Tailscale: http://100.100.210.126:3007).
ADDR=0.0.0.0:3007
PORT=3007

# Base SQLite. En Docker el volumen apunta a /data.
DB_PATH=data/fitordie.db

# Opcional: CSV de alimentos. Vacío = se usa el embebido en el binario.
#CSV_PATH=../data/alimentos.csv

TIMEZONE=America/Argentina/Cordoba
TZ_NAME=America/Argentina/Cordoba

# Memoria: binario liviano, <100 MB RSS.
GOMEMLIMIT=64MiB
GOGC=50
MEM_LIMIT_BYTES=67108864
GC_PERCENT=50

LOG_LEVEL=info

# --- Autenticación (obligatoria) -----------------------------------------
# Un único usuario. La clave NUNCA se guarda en claro: solo su hash bcrypt
# (coste 12) calculado fuera del repo. Si falta cualquiera de las tres
# variables, `fitordie serve` no arranca (fail closed).
#
# Generar el hash:
#   htpasswd -nbBC 12 usuario 'CLAVE' | cut -d: -f2     (hash $2y$ -> usar $2a$)
# o con un one-liner de Go: bcrypt.GenerateFromPassword(clave, 12).
#
# Generar el secreto: openssl rand -base64 48   (mínimo 32 bytes)
APP_USER=tu@email.com
APP_PASSWORD_HASH='$2a$12$reemplazar_por_el_hash_bcrypt_de_la_clave'
SESSION_SECRET=reemplazar_por_openssl_rand_base64_48

# --- Estimación por texto libre / foto (opcional, OpenAI-compatible) -------
# Sin estas variables la app funciona igual: el parser local es determinista
# y lo que no se puede calcular se muestra como "sin datos".
# Jamás poner una key real en git.
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_API_KEY=
#LLM_MODEL=gpt-4o-mini
