# Copiar a .env y completar: cp env.example .env
# Jamás commitear el .env real.
POSTGRES_USER=fitordie
POSTGRES_PASSWORD=cambiar-esto-en-produccion
POSTGRES_DB=fitordie
DATABASE_URL=postgres://fitordie:cambiar-esto-en-produccion@localhost:5432/fitordie
# Auth (next-auth v4): generar con `openssl rand -base64 32`. Solo en .env real, jamás en git.
NEXTAUTH_SECRET=cambiar-esto-en-produccion
# En producción: la URL pública (https://...). En dev se puede omitir.
NEXTAUTH_URL=http://localhost:3000
# Opcional: visión para fotos. Opciones (solo UNA, por entorno, jamás en git):
#   - nada (default): la foto se guarda y se carga manual.
#   - Ollama local/autocontenido: OLLAMA_URL (+ OLLAMA_MODEL, default moondream).
#     En dev local: http://localhost:11434. En server propio:
#     docker compose --profile vision up -d con OLLAMA_URL=http://ollama:11434.
#   - Gemini (nube, gratis con límites): VISION_PROVIDER=gemini + GEMINI_API_KEY.
#   - Groq (nube, gratis con límites): VISION_PROVIDER=groq + GROQ_API_KEY.
# OJO: con gemini/groq TUS FOTOS salen a esa nube. Solo configuralo si te sirve.
#VISION_PROVIDER=gemini
#VISION_MODEL=gemini-2.0-flash
#GEMINI_API_KEY=
#GROQ_API_KEY=
#UPLOADS_DIR=./uploads
